# Copy this file to .env and replace placeholders. Never commit .env.
# Security: VITE_* values are embedded in the browser bundle. Keep production
# service-account private keys and other true secrets in a backend-only environment.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

VITE_FIREBASE_API_KEY_HR=your_hr_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN_HR=your-hr-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL_HR=https://your-hr-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID_HR=your-hr-project-id
VITE_FIREBASE_STORAGE_BUCKET_HR=your-hr-project.firebasestorage.app

VITE_GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
VITE_GOOGLE_SHEET_API_KEY=your_private_key
VITE_TOKEN_URI=https://oauth2.googleapis.com/token

VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

VITE_HR_EVALUATION_CODE_SHEET_ID=your_code_sheet_id
VITE_HR_EVALUATION_CODE_SHEET_GID=0
VITE_HR_EVALUATION_CODE_SHEET_SOURCE_URL=https://docs.google.com/spreadsheets/d/your_code_sheet_id/edit

