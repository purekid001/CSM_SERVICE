# Copy this file to .env and replace placeholders. Never commit .env.
# Security: VITE_* values are embedded in the browser bundle. Gemini credentials
# and Google Workspace configuration belong in Firebase Secret Manager only:
# GEMINI_API_KEY and SHEETS_CONFIG.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Set to true only while the local Functions Emulator is running.
VITE_USE_FUNCTIONS_EMULATOR=false


VITE_GAS_REPORT_URL=your_google_apps_script_web_app_url

VITE_ENG_REPAIR_REPORT_SHEET_SOURCE_URL=https://docs.google.com/spreadsheets/d/your_eng_repair_report_sheet_id/edit
VITE_HR_BOOKING_REPORT_SHEET_SOURCE_URL=https://docs.google.com/spreadsheets/d/your_hr_booking_report_sheet_id/edit
